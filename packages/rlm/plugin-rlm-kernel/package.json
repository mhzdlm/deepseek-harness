{
  "name": "@deepseek-ai/dsh-plugin-rlm-kernel",
  "description": "Persistent IPython kernel as the model's primary tool, vendored from Prime Intellect prime-agent. Provides the `ipython` tool, per-session kernel lifecycle, dill namespace snapshots, and the `rlm.*` host bridge.",
  "version": "0.1.1-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/rlm/plugin-rlm-kernel"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "test": "vitest run --root ../../../ --no-file-parallelism packages/rlm/plugin-rlm-kernel/tests/host-smoke.spec.ts packages/rlm/plugin-rlm-kernel/tests/host-handlers.spec.ts packages/rlm/plugin-rlm-kernel/tests/ipython-tool.spec.ts packages/rlm/plugin-rlm-kernel/tests/rlm-bootstrap.spec.ts packages/rlm/plugin-rlm-kernel/tests/session-query.spec.ts packages/rlm/plugin-rlm-kernel/tests/keep-alive.spec.ts packages/rlm/plugin-rlm-kernel/tests/skill-source.spec.ts packages/rlm/plugin-rlm-kernel/tests/skill-create.spec.ts packages/rlm/plugin-rlm-kernel/tests/loop-audit-skill.spec.ts packages/rlm/plugin-rlm-kernel/tests/env.spec.ts packages/rlm/plugin-rlm-kernel/tests/kernel-env.spec.ts packages/rlm/plugin-rlm-kernel/tests/platform.spec.ts packages/rlm/plugin-rlm-kernel/tests/idle-tracker.spec.ts packages/rlm/plugin-rlm-kernel/tests/idle-reclaim.spec.ts packages/rlm/plugin-rlm-kernel/tests/provision-dedup.spec.ts packages/rlm/plugin-rlm-kernel/tests/warmup.spec.ts packages/rlm/plugin-rlm-kernel/tests/cancel.spec.ts packages/rlm/plugin-rlm-kernel/tests/conversation-snapshot.spec.ts packages/rlm/plugin-rlm-kernel/tests/kernel-env-runtime.spec.ts packages/rlm/plugin-rlm-kernel/tests/persistence-catalog.spec.ts packages/rlm/plugin-rlm-kernel/tests/snapshot-rotation.spec.ts",
    "test:e2e": "vitest run --root ../../../ --no-file-parallelism packages/rlm/plugin-rlm-kernel/tests/rlm-e2e.spec.ts packages/rlm/plugin-rlm-kernel/tests/refine-e2e.spec.ts",
    "vendor:check": "node --import tsx scripts/audit-vendor.mts"
  },
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/types/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/types/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "src/**/*",
    "vendor/prime-agent-runtime/**"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-plugin-continual-harness": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "uuid": "^14.0.0",
    "zeromq": "^6.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  }
}

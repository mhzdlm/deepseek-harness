{
  "name": "@deepseek-ai/dsh-plugin-rlm-loop",
  "description": "Loop Engineering bookkeeping for the rlm family: a `loop` tool that parses the auditor's three-line report header deterministically, appends session/loop-* process events, and lands verified progress into the continual-harness state through its CAS pipeline. The joining session stays the Manager; episodes ride the composition-provided executor/auditor delegation tools.",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/rlm/plugin-rlm-loop"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "test": "vitest run --root ../../../ packages/rlm/plugin-rlm-loop/tests/parser.spec.ts packages/rlm/plugin-rlm-loop/tests/loop-tool.spec.ts packages/rlm/plugin-rlm-loop/tests/persistence-catalog.spec.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "src/**/*"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-plugin-rlm-store": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  }
}

{
  "name": "@deepseek-ai/dsh-plugin-rlm-moa",
  "description": "Mixture-of-Agents panel as a `moa` tool: parallel pure-LLM reference fan-out across configured provider routes plus an aggregator synthesis, hosted entirely through the harness LLM seam.",
  "version": "0.1.1-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/rlm/plugin-rlm-moa"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "test": "vitest run --root ../../../ packages/rlm/plugin-rlm-moa/tests/moa.spec.ts packages/rlm/plugin-rlm-moa/tests/redact.spec.ts packages/rlm/plugin-rlm-moa/tests/preset-store.spec.ts packages/rlm/plugin-rlm-moa/tests/llm-stream.spec.ts packages/rlm/plugin-rlm-moa/tests/persistence-catalog.spec.ts"
  },
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/types/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/types/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "src/**/*"
  ],
  "license": "MIT",

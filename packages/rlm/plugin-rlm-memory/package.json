{
  "name": "@deepseek-ai/dsh-plugin-rlm-memory",
  "description": "RLM cross-session memory (Phase A write path): captures completed root sessions, sanitizes the transcript (tool results stripped), writes dialog/<id>.jsonl, spawns a host-owned extraction subagent whose draft notes pass an evidence-locator gate before landing in drafts/, and emits a log-only session/memory-captured event. Phase B (memory_search) + C (consolidation/rollback, reverse-snapshot rollback, growth budget) + D (retire/archive: aging scan + reversible archive move under exitMode off|observe|enforce) implemented. Exposes /memory list|show|delete|consolidate|rollback|retire|archived|unretire.",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/rlm/plugin-rlm-memory"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "test": "vitest run --root ../../../ packages/rlm/plugin-rlm-memory/tests/sanitize.spec.ts packages/rlm/plugin-rlm-memory/tests/frontmatter.spec.ts packages/rlm/plugin-rlm-memory/tests/evidence.spec.ts packages/rlm/plugin-rlm-memory/tests/memory-cmd.spec.ts packages/rlm/plugin-rlm-memory/tests/persistence-catalog.spec.ts packages/rlm/plugin-rlm-memory/tests/search.spec.ts packages/rlm/plugin-rlm-memory/tests/memory-search-tool.spec.ts packages/rlm/plugin-rlm-memory/tests/consolidate.spec.ts packages/rlm/plugin-rlm-memory/tests/rollback.spec.ts packages/rlm/plugin-rlm-memory/tests/budget.spec.ts packages/rlm/plugin-rlm-memory/tests/retire.spec.ts",
    "test:e2e": "vitest run --root ../../../ --config vitest.e2e.config.ts packages/rlm/plugin-rlm-memory/tests/rlm-memory-real.e2e.ts"
  },
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/types/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "src/**/*"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-commands": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-commands": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  }
}

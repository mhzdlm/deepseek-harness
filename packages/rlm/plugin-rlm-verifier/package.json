{
  "name": "@deepseek-ai/dsh-plugin-rlm-verifier",
  "description": "LLM-as-a-Verifier: fine-grained reward (Eq 3.1 expectation over scoring-token logprobs) + Probabilistic Pivot Tournament best-of-N selection, exposed as a `verify` tool. Pairs with @deepseek-ai/dsh-plugin-rlm-kernel for best-of-N over rlm-run child trajectories.",
  "version": "0.1.1-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/rlm/plugin-rlm-verifier"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "test": "vitest run --root ../../../ packages/rlm/plugin-rlm-verifier/tests/verify.spec.ts packages/rlm/plugin-rlm-verifier/tests/rlm-preset.spec.ts packages/rlm/plugin-rlm-verifier/tests/python-bridge.spec.ts packages/rlm/plugin-rlm-verifier/tests/fusion.spec.ts packages/rlm/plugin-rlm-verifier/tests/events.spec.ts",
    "test:e2e": "vitest run --root ../../../ --config ../../../vitest.e2e.config.ts packages/rlm/plugin-rlm-verifier/tests/judges.e2e.ts"
  },
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/types/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "src/**/*"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-plugin-rlm-kernel": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  }
}
